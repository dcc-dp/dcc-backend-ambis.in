# Koneksi ke Supabase Postgres — Direct connection atau Session pooler (port 5432).
# HINDARI Transaction pooler (port 6543) kecuali set statement_cache_size=0 di connect args —
# asyncpg pakai prepared statements otomatis, tidak kompatibel dengan Supavisor transaction mode.
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
# PENTING: skema harus "postgresql+asyncpg://" (bukan "postgresql://" polos dari dashboard).
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

# Fallback lokal (Docker Postgres biasa) kalau lagi offline dari Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres:root@127.0.0.1:5432/ambisin_db

# Kunci JWT & Auth (verifikasi token lokal — terpisah dari Supabase Auth)
SECRET_KEY=ganti_dengan_secret_key_acak_kamu
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Supabase project keys ---
# Belum dipakai oleh kode saat ini (baru dibutuhkan saat integrasi Storage foto PR / verifikasi JWT Supabase Auth,
# lihat AMBIS_DB_Architecture.md §2). Diisi sekarang sekalian biar tidak perlu setup ulang nanti — boleh dikosongkan dulu.
# Ambil dari: Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM Provider (OpenAI-compatible endpoint; 9router is no longer used) ---
# Default: Google Gemini via its OpenAI-compatible endpoint. Chat AND embeddings
# share this base URL + key, so set it to:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# and put your Gemini API key in LLM_API_KEY. Fill LLM_MODEL_* with a Gemini
# model ID (see DEFAULT_MODEL_ID in app/api/v1/services/multi_ai.py).
#
# Alternative for chat only: Groq (https://api.groq.com/openai/v1). Groq has NO
# /embeddings endpoint, so embeddings (retriever, backfill) would break unless a
# separate embedding endpoint is added to the code first.

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_GRADING=PLACEHOLDER_MODEL
LLM_MODEL_DIAGNOSIS=PLACEHOLDER_MODEL
LLM_MODEL_INTERVENTION=PLACEHOLDER_MODEL

# --- Embeddings (same endpoint + key as above, different route+model) ---
# Used by scripts/backfill_embeddings.py for curriculum_chunks.embedding (vector(768)).
# Defaults already match what's confirmed working — usually no need to override these two.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

